# 복사해서 .env 로 쓰세요:  cp .env.example .env
# .env 는 git 에 올라가지 않습니다. 팀원마다 각자 만듭니다.

HANAAI_ENV=local
HANAAI_LOG_LEVEL=INFO

# 각자 로컬 PostgreSQL. 팀원끼리 공유하지 않습니다.
# 저장소에 들어 있는 것은 스키마(db/migrations)와 시드(db/seeds)뿐이고,
# 데이터는 각자 alembic + seed.py 로 자기 DB 에 만듭니다.
HANAAI_DATABASE_URL=postgresql+psycopg://hanaai:hanaai@localhost:5432/hanaai

# 분석 Agent 백엔드
#   claude-cli    (기본) 로그인된 claude CLI 사용. `claude login` 외에 설정 불필요.
#   claude-api    ANTHROPIC_API_KEY 필요. pip install -e ".[agents]"
#   passthrough   LLM 없이 규칙 기반. 오프라인/테스트용. 돈이 안 든다.
HANAAI_ANALYST_BACKEND=claude-cli
# 비우면 백엔드별 기본 모델 (CLI: opus, API: claude-opus-5)
HANAAI_ANALYST_MODEL=

# 수집 API
HANAAI_INGEST_MAX_BATCH=1000

# 키오스크 디바이스 인증 (스켈레톤 단계에서는 공유 토큰, 운영에서는 mTLS 로 교체)
HANAAI_DEVICE_TOKEN=dev-only-token
